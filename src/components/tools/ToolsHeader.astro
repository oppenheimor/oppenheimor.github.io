<header class="toolsHeader">
  <a class="identity" href="/" aria-label="返回 Oppenheimor 首页" data-home-return>
    <span class="dot" aria-hidden="true"></span>OPPENHEIMOR®
  </a>
  <nav aria-label="工具箱导航">
    <a href="/tools">工具箱</a>
    <a href="https://github.com/oppenheimor" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
  </nav>
</header>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-home-return]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      try {
        const previous = new URL(document.referrer);
        if (history.length > 1 && previous.origin === location.origin && previous.pathname === '/') {
          event.preventDefault();
          history.back();
        }
      } catch {
        // Keep the normal home link as a safe fallback when there is no usable referrer.
      }
    });
  });
</script>

<style>
  .toolsHeader {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding-top: 34px;
    color: var(--text-secondary);
    font-size: 12px;
    letter-spacing: 0.1em;
  }

  .identity,
  nav a {
    color: inherit;
    text-decoration: none;
    transition: color 0.45s var(--ease-out);
  }

  .identity { white-space: nowrap; }

  .dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 10px;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 14px oklch(0.79 0.105 205 / 0.3);
  }

  nav { display: flex; gap: 22px; }
  a:hover { color: var(--ink); }

  @media (max-width: 700px) {
    .toolsHeader {
      padding-top: 22px;
      font-size: 10px;
      letter-spacing: 0.07em;
    }

    nav { gap: 13px; }
    .dot { width: 6px; height: 6px; margin-right: 7px; }
  }
</style>
