---
import GlobalCursor from '../GlobalCursor.astro';
import CoverLightbox from '../CoverLightbox.astro';
---

<GlobalCursor />
<CoverLightbox />
<div class="grid" aria-hidden="true"></div>
<div class="glow" aria-hidden="true"></div>
<div class="orb orbOne" aria-hidden="true"></div>
<div class="orb orbTwo" aria-hidden="true"></div>
<div class="progress" aria-hidden="true">
  <span class="progressLabel">00</span>
  <span class="progressTrack"><span class="progressFill"></span></span>
</div>

<script>
  const label = document.querySelector<HTMLElement>('.progressLabel');
  const fill = document.querySelector<HTMLElement>('.progressFill');
  const updateProgress = () => {
    const available = document.documentElement.scrollHeight - window.innerHeight;
    const progress = available > 0 ? Math.min(100, Math.max(0, (window.scrollY / available) * 100)) : 0;
    if (label) label.textContent = String(Math.round(progress)).padStart(2, '0');
    if (fill) fill.style.transform = `scaleY(${progress / 100})`;
  };

  updateProgress();
  addEventListener('scroll', updateProgress, { passive: true });
  addEventListener('resize', updateProgress);
</script>

<style>
  .grid,
  .glow,
  .orb {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .grid {
    background-image:
      linear-gradient(oklch(0.74 0.045 252 / 0.052) 1px, transparent 1px),
      linear-gradient(90deg, oklch(0.74 0.045 252 / 0.052) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, black 0%, black 72%, transparent 100%);
  }

  .glow {
    background:
      radial-gradient(68% 44% at 52% -8%, oklch(0.59 0.18 266 / 0.2), transparent 72%),
      linear-gradient(180deg, oklch(0.17 0.055 270 / 0.38), transparent 38%);
  }

  .orb {
    width: 34rem;
    height: 34rem;
    border-radius: 50%;
    background: radial-gradient(circle, oklch(0.57 0.18 268 / 0.11), transparent 70%);
    filter: blur(28px);
    animation: drift 18s ease-in-out infinite alternate;
  }

  .orbOne {
    inset: 10% auto auto -22rem;
  }

  .orbTwo {
    inset: auto -25rem 5% auto;
    animation-delay: -8s;
  }

  .progress {
    position: fixed;
    top: 50%;
    left: 28px;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 12px;
    transform: translateY(-50%);
    color: var(--text-muted);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .progressTrack {
    width: 2px;
    height: 120px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--hairline);
  }

  .progressFill {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleY(0);
    transform-origin: top;
    background: var(--ink);
  }

  @keyframes drift {
    to { transform: translate3d(5rem, 2rem, 0) scale(1.08); }
  }

  @media (max-width: 700px) {
    .progress { display: none; }
    .orb { display: none; }
  }
</style>
