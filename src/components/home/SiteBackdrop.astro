<div class="grid" aria-hidden="true"></div>
<div class="glow" aria-hidden="true"></div>
<div class="orb orbOne" aria-hidden="true"></div>
<div class="orb orbTwo" aria-hidden="true"></div>
<div class="progress" aria-hidden="true">
  <span class="progressLabel">00</span>
  <span class="progressTrack"><span class="progressFill"></span></span>
</div>

<script>
  const label = document.querySelector<HTMLElement>('.progressLabel');
  const fill = document.querySelector<HTMLElement>('.progressFill');
  const updateProgress = () => {
    const available = document.documentElement.scrollHeight - window.innerHeight;
    const progress = available > 0 ? Math.min(100, Math.max(0, (window.scrollY / available) * 100)) : 0;
    if (label) label.textContent = String(Math.round(progress)).padStart(2, '0');
    if (fill) fill.style.transform = `scaleY(${progress / 100})`;
  };

  updateProgress();
  addEventListener('scroll', updateProgress, { passive: true });
  addEventListener('resize', updateProgress);
</script>

<style>
  .grid,
  .glow,
  .orb {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .grid {
    background-image:
      linear-gradient(oklch(0.2 0.006 75 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, oklch(0.2 0.006 75 / 0.035) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .glow {
    background: radial-gradient(80% 50% at 50% -10%, oklch(0.89 0.12 88 / 0.22), transparent 70%);
  }

  .orb {
    width: 34rem;
    height: 34rem;
    border-radius: 50%;
    background: radial-gradient(circle, oklch(0.89 0.12 88 / 0.13), transparent 70%);
    filter: blur(20px);
    animation: drift 18s ease-in-out infinite alternate;
  }

  .orbOne {
    inset: 10% auto auto -22rem;
  }

  .orbTwo {
    inset: auto -25rem 5% auto;
    animation-delay: -8s;
  }

  .progress {
    position: fixed;
    top: 50%;
    left: 28px;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 12px;
    transform: translateY(-50%);
    color: var(--text-muted);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .progressTrack {
    width: 2px;
    height: 120px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--hairline);
  }

  .progressFill {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleY(0);
    transform-origin: top;
    background: var(--ink);
  }

  @keyframes drift {
    to { transform: translate3d(5rem, 2rem, 0) scale(1.08); }
  }

  @media (max-width: 700px) {
    .progress { display: none; }
    .orb { display: none; }
  }
</style>
