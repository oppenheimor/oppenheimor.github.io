---
import GlobalCursor from '../GlobalCursor.astro';
import CoverLightbox from '../CoverLightbox.astro';

interface Props {
  showProgress?: boolean;
}

const { showProgress = true } = Astro.props;
---

<GlobalCursor />
<CoverLightbox />
<div class="glow" aria-hidden="true"></div>
<div class="orb orbOne" aria-hidden="true"></div>
<div class="orb orbTwo" aria-hidden="true"></div>
{showProgress && (
  <div class="progress" aria-hidden="true">
    <span class="progressLabel">00</span>
    <span class="progressTrack"><span class="progressFill"></span></span>
  </div>
)}

<script>
  const updateProgress = () => {
    // Astro transitions replace the page DOM without re-running this script.
    // Query the current nodes on every update so returning from a detail page
    // does not keep writing to the old progress elements.
    const label = document.querySelector<HTMLElement>('.progressLabel');
    const fill = document.querySelector<HTMLElement>('.progressFill');
    const available = document.documentElement.scrollHeight - window.innerHeight;
    const progress = available > 0 ? Math.min(100, Math.max(0, (window.scrollY / available) * 100)) : 0;
    if (label) label.textContent = String(Math.round(progress)).padStart(2, '0');
    if (fill) fill.style.transform = `scaleY(${progress / 100})`;
  };

  updateProgress();
  addEventListener('scroll', updateProgress, { passive: true });
  addEventListener('resize', updateProgress);
  document.addEventListener('astro:page-load', updateProgress);
</script>

<style>
  .glow,
  .orb {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .glow {
    background:
      radial-gradient(58% 34% at 50% -10%, oklch(0.72 0.006 90 / 0.08), transparent 74%),
      linear-gradient(180deg, oklch(0.2 0.006 90 / 0.12), transparent 42%);
  }

  .orb {
    width: 34rem;
    height: 34rem;
    border-radius: 50%;
    background: radial-gradient(circle, oklch(0.72 0.006 90 / 0.055), transparent 70%);
    filter: blur(28px);
    animation: drift 18s ease-in-out infinite alternate;
  }

  .orbOne {
    inset: 10% auto auto -22rem;
  }

  .orbTwo {
    inset: auto -25rem 5% auto;
    animation-delay: -8s;
  }

  .progress {
    position: fixed;
    top: 50%;
    left: 28px;
    z-index: 10;
    width: 3ch;
    height: 120px;
    transform: translateY(-50%);
    color: var(--text-muted);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .progressLabel {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    width: 3ch;
    background: var(--canvas);
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .progressTrack {
    position: absolute;
    top: 0;
    left: 50%;
    width: 2px;
    height: 120px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--hairline);
    transform: translateX(-50%);
  }

  .progressFill {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleY(0);
    transform-origin: top;
    background: var(--ink);
  }

  @keyframes drift {
    to { transform: translate3d(5rem, 2rem, 0) scale(1.08); }
  }

  @media (max-width: 700px) {
    .progress { display: none; }
    .orb { display: none; }
  }
</style>
