---
import { getCollection } from 'astro:content';
import { sortTools, toolPath } from '../../lib/tools';

const toolPreview = sortTools(await getCollection('tools', ({ data }) => data.published)).filter((tool) => !tool.data.retired).slice(0, 4);
---

<section id="garden" class="garden" aria-labelledby="garden-heading" data-reveal>
  <span class="sectionNumber" aria-hidden="true"><span>0</span><span data-section-digit>1</span></span>
  <h2 id="garden-heading" class="visuallyHidden">Oppenheimor 的数字花园</h2>

  <span class="tabsSentinel" data-tabs-sentinel aria-hidden="true"></span>
  <div class="tabsDock" data-tabs-dock>
    <div class="tabs" role="tablist" aria-label="内容分类">
      <button id="tab-projects" class="tab isActive" type="button" role="tab" aria-selected="true" aria-controls="panel-projects" tabindex="0">项目</button>
      <button id="tab-tools" class="tab" type="button" role="tab" aria-selected="false" aria-controls="panel-tools" tabindex="-1">工具箱</button>
      <button id="tab-notes" class="tab" type="button" role="tab" aria-selected="false" aria-controls="panel-notes" tabindex="-1">Notes</button>
      <button id="tab-writing" class="tab" type="button" role="tab" aria-selected="false" aria-controls="panel-writing" tabindex="-1">文章</button>
      <button id="tab-about" class="tab" type="button" role="tab" aria-selected="false" aria-controls="panel-about" tabindex="-1">关于我</button>
      <button id="tab-life" class="tab" type="button" role="tab" aria-selected="false" aria-controls="panel-life" tabindex="-1">生活</button>
    </div>
  </div>

  <div id="panel-projects" class="panel panelProjects panelEnter" role="tabpanel" aria-labelledby="tab-projects">
    <article class="projectHitbox">
      <a class="projectCard" href="https://github.com/oppenheimor/oppenheimor.github.io" target="_blank" rel="noreferrer">
        <span class="projectNumber" aria-hidden="true">01</span>
        <div class="projectStage" aria-hidden="true">
          <div class="window">
            <span class="windowDot"></span><span class="windowDot"></span><span class="windowDot"></span>
            <div class="miniGrid"></div>
            <strong>ideas<br />take<br />root.</strong>
            <span class="miniSeed"></span>
          </div>
        </div>
        <div class="projectInfo">
          <span class="eyebrow">DIGITAL GARDEN / 2026</span>
          <h3>This Garden</h3>
          <p>从一个 Hello World 开始，记录技术、产品和生活里正在生长的东西。</p>
          <span class="go">查看源码 <span aria-hidden="true">→</span></span>
        </div>
      </a>
    </article>
    <p class="quietLine">下一件作品还在路上。这里不会用虚构案例填满版面。</p>
  </div>

  <div id="panel-tools" class="panel toolsPanel typeVariant trayVariant" role="tabpanel" aria-labelledby="tab-tools" hidden>
    {toolPreview.length > 0 ? (
      <div class="homeToolDesk">
        {toolPreview.map((tool) => (
          <article class:list={['homeToolFile', { textOnly: !tool.data.cover }]}>
            {tool.data.cover && <span class="fileCover" aria-hidden="true"><img src={tool.data.cover} alt="" loading="lazy" /></span>}
            {!tool.data.cover && <span class="typeCover" aria-hidden="true">/</span>}
            <a class="fileCaption" href={toolPath(tool)}>
              <strong>{tool.data.name}</strong>
              {tool.data.starred && (
                <svg class="fileStar" viewBox="0 0 32 32" role="img" aria-label="已星标">
                  <path d="M17 3 20.5 11.5 30 13 23 19.5 24 29 15.5 24.5 6 28 8 18.5 2 11 12 10Z" />
                </svg>
              )}
            </a>
            <a class="fileSource" href={tool.data.url} target="_blank" rel="noreferrer" aria-label={`访问 ${tool.data.name} 源站（新窗口打开）`}>SOURCE <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    ) : (
      <div class="statement compactStatement">
        <strong>工具已经记下，只是还没有公开摆上桌面。</strong>
      </div>
    )}
    <a class="toolboxLink" href="/tools">打开工具箱 <span aria-hidden="true">→</span></a>
  </div>

  <div id="panel-notes" class="panel textPanel" role="tabpanel" aria-labelledby="tab-notes" hidden>
    <p class="panelKicker">NOTES / 随手记录</p>
    <div class="statement">
      <strong>花园刚刚翻土。</strong>
      <p>这里将收纳短笔记、过程记录和还没长成文章的想法。先保持空白，再慢慢种下真实内容。</p>
    </div>
    <div class="metaRow"><span>STATUS</span><span>SEEDLING</span><span>持续生长中</span></div>
  </div>

  <div id="panel-writing" class="panel writingPanel" role="tabpanel" aria-labelledby="tab-writing" hidden>
    <a class="articleRow" href="#hello-world">
      <time datetime="2026-09-07">2026.09.07</time>
      <span><strong>Hello World</strong><small>第一篇还没写完，但网站已经先站起来了。</small></span>
      <b aria-hidden="true">→</b>
    </a>
    <p id="hello-world" class="quietLine">文章系统将在下一阶段加入。这个入口暂时诚实地停在首页。</p>
  </div>

  <div id="panel-about" class="panel textPanel" role="tabpanel" aria-labelledby="tab-about" hidden>
    <p class="panelKicker">OPPENHEIMOR / ABOUT</p>
    <div class="statement">
      <strong>一个在代码、产品与日常之间持续学习的人。</strong>
      <p>这里是我的公开数字花园。完整经历和真实姓名会在准备好后补进来，现在先让作品与思考说话。</p>
    </div>
    <ul class="tags" aria-label="关注领域">
      <li>ENGINEERING</li><li>PRODUCT</li><li>AI</li><li>LIFE</li>
    </ul>
  </div>

  <div id="panel-life" class="panel textPanel" role="tabpanel" aria-labelledby="tab-life" hidden>
    <p class="panelKicker">LIFE / 普通日子</p>
    <div class="statement">
      <strong>不是每件事都需要成为项目。</strong>
      <p>以后会在这里放旅行、阅读、照片，以及那些值得记住却不必总结成方法论的瞬间。</p>
    </div>
    <div class="lifeMarks" aria-hidden="true"><span>读</span><span>走</span><span>看</span><span>想</span></div>
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const digit = document.querySelector<HTMLElement>('[data-section-digit]');
  const tabsDock = document.querySelector<HTMLElement>('[data-tabs-dock]');
  const tabsSentinel = document.querySelector<HTMLElement>('[data-tabs-sentinel]');

  if (tabsDock && tabsSentinel && 'IntersectionObserver' in window) {
    const stickyObserver = new IntersectionObserver(([entry]) => {
      const isStuck = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      tabsDock.classList.toggle('isStuck', isStuck);
    }, { rootMargin: '-1px 0px 0px', threshold: 0 });
    stickyObserver.observe(tabsSentinel);
  }

  const selectTab = (selected: HTMLButtonElement, shouldScroll = true, shouldPersist = true) => {
    tabs.forEach((tab) => {
      const active = tab === selected;
      tab.classList.toggle('isActive', active);
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
      const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
      if (panel) {
        panel.hidden = !active;
        panel.classList.toggle('panelEnter', active);
      }
    });
    if (digit) digit.textContent = String(tabs.indexOf(selected) + 1);
    if (shouldPersist) {
      const currentState = typeof history.state === 'object' && history.state !== null ? history.state : {};
      history.replaceState({ ...currentState, gardenTab: selected.id }, '');
    }
    if (shouldScroll) selected.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectTab(tab));
    tab.addEventListener('keydown', (event) => {
      let next = index;
      if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      else return;
      event.preventDefault();
      tabs[next].focus();
      selectTab(tabs[next]);
    });
  });

  const savedTab = tabs.find((tab) => tab.id === history.state?.gardenTab);
  if (savedTab) selectTab(savedTab, false, false);
</script>

<style>
  .garden {
    position: relative;
    padding: 12vh 0;
  }

  .visuallyHidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .sectionNumber {
    position: absolute;
    top: 5vh;
    right: -0.05em;
    z-index: -1;
    display: flex;
    color: transparent;
    font-size: clamp(120px, 22vw, 220px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    -webkit-text-stroke: 1px oklch(0.72 0.08 245 / 0.16);
    user-select: none;
  }

  .tabsSentinel {
    display: block;
    height: 1px;
    margin-bottom: -1px;
    pointer-events: none;
  }

  .tabsDock {
    position: sticky;
    top: calc(env(safe-area-inset-top, 0px) + 18px);
    z-index: 10;
    isolation: isolate;
    margin-bottom: 48px;
  }

  .tabsDock::before {
    position: absolute;
    top: calc(-18px - env(safe-area-inset-top, 0px));
    bottom: -26px;
    left: 50%;
    z-index: -1;
    width: 100vw;
    background: linear-gradient(
      to bottom,
      var(--canvas) 0%,
      var(--canvas) 72%,
      oklch(0.125 0.032 264 / 0.78) 86%,
      oklch(0.125 0.032 264 / 0) 100%
    );
    backdrop-filter: blur(10px) saturate(0.86);
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%);
    transition: opacity 0.45s var(--ease-out);
    -webkit-backdrop-filter: blur(10px) saturate(0.86);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 82%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 0%, black 82%, transparent 100%);
  }

  .tabsDock.isStuck::before { opacity: 1; }

  .tabs {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    gap: 42px;
    width: 100%;
    padding: 0 0 16px;
  }

  .tab {
    position: relative;
    display: flex;
    flex: none;
    min-height: 1.16em;
    align-items: flex-end;
    padding: 0 0 10px;
    border: 0;
    background: transparent;
    color: oklch(0.57 0.035 245);
    cursor: pointer;
    font-size: clamp(30px, 5.2vw, 48px);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.03em;
    opacity: 0.76;
    transition: color 0.6s var(--ease-out), opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
  }

  .tab::after {
    position: absolute;
    bottom: 2px;
    left: -2%;
    z-index: -1;
    width: 104%;
    height: 0.32em;
    background: var(--highlight);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s var(--ease-out);
  }

  .tab.isActive {
    color: var(--ink);
    opacity: 1;
  }

  .tab.isActive::after { transform: scaleX(1); }

  .panel[hidden] { display: none; }

  .panelEnter { animation: panelIn 0.9s var(--ease-out); }

  @keyframes panelIn {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .panelProjects {
    display: grid;
    gap: 16px;
  }

  .projectCard {
    position: relative;
    display: grid;
    min-height: 300px;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: 36px;
    padding: 22px 26px;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 20px;
    background: var(--canvas);
    color: inherit;
    text-decoration: none;
    transition: transform 0.45s var(--ease-out), box-shadow 0.7s var(--ease-out), border-color 0.7s var(--ease-out);
  }

  .projectNumber {
    position: absolute;
    bottom: 18px;
    left: 28px;
    color: transparent;
    font-size: 42px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    -webkit-text-stroke: 1px oklch(0.72 0.08 245 / 0.18);
    transition: transform 0.9s var(--ease-out);
  }

  .projectStage,
  .projectInfo { position: relative; z-index: 1; }

  .window {
    position: relative;
    height: 202px;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 14px;
    background: var(--highlight-soft);
    box-shadow: 0 18px 35px var(--shadow);
    transform: rotate(-2deg);
    transition: transform 0.7s var(--ease-out);
  }

  .windowDot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin: 12px 0 0 6px;
    border-radius: 50%;
    background: var(--text-muted);
  }

  .windowDot:first-child { margin-left: 13px; background: var(--signal); }

  .miniGrid {
    position: absolute;
    inset: 30px 0 0;
    background-image:
      linear-gradient(oklch(0.82 0.04 245 / 0.09) 1px, transparent 1px),
      linear-gradient(90deg, oklch(0.82 0.04 245 / 0.09) 1px, transparent 1px);
    background-size: 18px 18px;
  }

  .window strong {
    position: absolute;
    top: 52px;
    left: 24px;
    font-size: 38px;
    line-height: 0.88;
    letter-spacing: -0.06em;
  }

  .miniSeed {
    position: absolute;
    right: 34px;
    bottom: 43px;
    width: 35px;
    height: 35px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--highlight);
    box-shadow: 18px -18px 0 -12px var(--signal);
  }

  .eyebrow,
  .panelKicker,
  .metaRow {
    color: var(--text-muted);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
  }

  .projectInfo h3 {
    margin: 14px 0 12px;
    font-size: clamp(30px, 4vw, 40px);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .projectInfo p {
    max-width: 31ch;
    margin: 0 0 28px;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.75;
  }

  .go {
    font-size: 12px;
    letter-spacing: 0.08em;
  }

  .go span {
    display: inline-block;
    margin-left: 6px;
    transition: transform 0.5s var(--ease-out);
  }

  .quietLine {
    margin: 16px 4px 0;
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.7;
  }

  .textPanel,
  .toolsPanel {
    min-height: 510px;
    padding: 60px 0 20px;
  }

  .toolsPanel { min-height: 0; padding-top: 12px; }

  .homeToolDesk {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    padding: 1px;
    background: var(--hairline);
  }

  .homeToolFile {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    padding: 24px;
    background: var(--canvas);
    color: var(--ink);
    text-decoration: none;
  }
  .homeToolFile:focus-visible { position: relative; z-index: 1; outline-offset: -4px; }
  .fileCover { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: contain; }
  .fileCaption { display: flex; justify-content: space-between; align-items: center; gap: 16px; transition: transform 0.4s var(--ease-out); }
  .fileCaption strong { min-width: 0; font-size: clamp(22px, 3vw, 28px); letter-spacing: -0.04em; overflow-wrap: anywhere; }
  .fileStar {
    flex: none;
    width: 26px;
    height: 26px;
    overflow: visible;
    color: var(--highlight);
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linejoin: round;
    transform: rotate(-9deg);
    transition: transform 0.5s var(--ease-out);
  }
  .textOnly { justify-content: center; }
  .textOnly .fileCaption strong { font-size: clamp(30px, 4vw, 42px); }
  .homeToolFile:focus-visible .fileCaption { transform: translateY(-2px); }

  .typeVariant .homeToolDesk {
    gap: 20px 42px;
    padding: 16px 0 32px;
    background: transparent;
    align-items: start;
  }
  .typeVariant .homeToolFile {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    min-height: 205px;
    gap: 0;
    padding: 24px 0;
    background: transparent;
    isolation: isolate;
  }
  .typeVariant .homeToolFile:nth-child(even) { margin-top: 76px; }
  .typeVariant .fileCover {
    grid-column: 2;
    grid-row: 1;
    width: 115%;
    max-width: none;
    margin-left: -15%;
    aspect-ratio: 4 / 3;
    border-radius: 7px;
    object-fit: contain;
    background: var(--surface);
    box-shadow: 0 18px 30px -18px var(--shadow);
    transform: rotate(5deg) translateY(-24px);
    transition: transform 0.6s var(--ease-out);
  }
  .typeVariant .homeToolFile:nth-child(even) .fileCover { transform: rotate(-5deg) translateY(-24px); }
  .typeVariant .fileCaption {
    position: relative;
    z-index: 1;
    grid-column: 1 / -1;
    grid-row: 1;
    justify-content: flex-start;
    align-self: end;
    gap: 10px;
    padding: 0 0 2px;
    transform: none;
  }
  .typeVariant .fileCaption strong {
    position: relative;
    font-size: clamp(35px, 4.6vw, 52px);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }
  .typeVariant .fileCaption strong::after {
    position: absolute;
    z-index: -1;
    right: -3px;
    bottom: -3px;
    left: -3px;
    height: 0.2em;
    background: var(--highlight);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }
  .typeVariant .fileStar { align-self: center; }
  .typeVariant .textOnly { min-height: 0; padding: 36px 0; }
  .typeVariant .textOnly .fileCaption { grid-row: auto; align-self: center; }
  .typeVariant .textOnly .fileCaption strong { font-size: clamp(38px, 5vw, 58px); }
  .typeVariant .homeToolFile:focus-visible { outline-offset: 6px; }
  .typeVariant .homeToolFile:focus-visible .fileCaption strong::after { transform: scaleX(1); }
  .typeVariant .homeToolFile:focus-visible .fileCover { transform: translateY(-31px) rotate(0); }

  @media (hover: hover) and (pointer: fine) {
    .typeVariant .homeToolFile:hover .fileCaption { transform: none; }
    .typeVariant .fileCaption:hover strong::after { transform: scaleX(1); }
  }

  @media (max-width: 700px) {
    .typeVariant .homeToolDesk { grid-template-columns: 1fr; gap: 22px; }
    .typeVariant .homeToolFile { min-height: 190px; padding: 20px 4px; }
    .typeVariant .homeToolFile:nth-child(even) { margin-top: 0; }
    .typeVariant .fileCover { width: 100%; margin-left: 0; }
    .typeVariant .fileCaption strong { font-size: clamp(36px, 10vw, 52px); }
    .typeVariant .textOnly { min-height: 0; padding: 30px 4px; }
  }

  .trayVariant .homeToolDesk {
    position: relative;
    padding: 0;
    gap: 32px;
    grid-auto-rows: 1fr;
    align-items: stretch;
  }
  .trayVariant .homeToolDesk:has(> article:nth-child(4))::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 28px;
    height: 28px;
    background: var(--highlight);
    opacity: 0.5;
    clip-path: polygon(0 30%, 38% 30%, 38% 0, 70% 0, 100% 30%, 70% 30%, 70% 100%, 38% 100%, 0 65%);
    transform: translate(-50%, -50%);
    content: '';
    pointer-events: none;
  }
  .trayVariant .homeToolFile,
  .trayVariant .homeToolFile:nth-child(even) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    gap: 24px;
    min-height: 240px;
    margin: 0;
    padding: 28px 24px;
  }
  .trayVariant .homeToolFile::before,
  .trayVariant .homeToolFile::after {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: oklch(0.43 0.05 255);
    border-style: solid;
    content: '';
    pointer-events: none;
  }
  .trayVariant .homeToolFile::before { top: 0; left: 0; border-width: 1px 0 0 1px; }
  .trayVariant .homeToolFile::after { right: 0; bottom: 0; border-width: 0 1px 1px 0; }
  .trayVariant .fileCover,
  .trayVariant .homeToolFile:nth-child(even) .fileCover {
    grid-column: 1;
    grid-row: 1;
    width: 100%;
    margin: 0;
    aspect-ratio: 16 / 9;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    transform: none;
  }
  .trayVariant .fileCaption,
  .trayVariant .textOnly .fileCaption { grid-column: 1; grid-row: 2; align-self: end; padding-right: 82px; }
  .trayVariant .fileCaption strong,
  .trayVariant .textOnly .fileCaption strong { font-size: clamp(30px, 4vw, 44px); }
  .typeCover { display: none; }
  .trayVariant .typeCover {
    display: grid;
    grid-column: 1;
    grid-row: 1;
    width: 100%;
    aspect-ratio: 16 / 9;
    place-items: center;
    color: var(--highlight);
    font-size: clamp(80px, 14vw, 150px);
    font-weight: 700;
    line-height: 1;
    transition: transform 0.6s var(--ease-out);
  }
  .trayVariant .homeToolFile:focus-visible .fileStar { transform: rotate(7deg); }
  .trayVariant .homeToolFile:focus-visible::before,
  .trayVariant .homeToolFile:focus-visible::after { border-color: var(--highlight); }
  .trayVariant .homeToolFile:focus-visible .fileCover,
  .trayVariant .homeToolFile:focus-visible .typeCover { transform: translateY(-5px) rotate(-4deg); }
  @media (hover: hover) and (pointer: fine) {
