---
import { getCollection } from 'astro:content';
import { sortTools, toolPath } from '../../lib/tools';
import { issueDate, issueLabel, sortWeekly, weeklyPath } from '../../lib/weekly';

const toolPreview = sortTools(await getCollection('tools', ({ data }) => data.published)).filter((tool) => !tool.data.retired).slice(0, 4);
const weeklyIssues = sortWeekly(await getCollection('weekly', ({ data }) => data.published));
const [latestIssue] = weeklyIssues;
const weeklyCardsPerPage = 3;
const weeklyPages = Array.from({ length: Math.ceil(weeklyIssues.length / weeklyCardsPerPage) }, (_, pageIndex) => weeklyIssues.slice(pageIndex * weeklyCardsPerPage, (pageIndex + 1) * weeklyCardsPerPage));
---

<section id="garden" class="garden" aria-labelledby="garden-heading" data-reveal>
  <span class="sectionNumber" aria-hidden="true"><span>0</span><span data-section-digit>1</span></span>
  <h2 id="garden-heading" class="visuallyHidden">Oppenheimor 的数字花园</h2>

  <span class="tabsSentinel" data-tabs-sentinel aria-hidden="true"></span>
  <div class="tabsDock" data-tabs-dock>
    <div class="tabs" role="tablist" aria-label="内容分类">
      <button id="tab-projects" class="tab isActive" type="button" role="tab" aria-selected="true" aria-controls="panel-projects" tabindex="0">项目</button>
      <button id="tab-writing" class="tab" type="button" role="tab" aria-selected="false" aria-controls="panel-writing" tabindex="-1">文章</button>
      <button id="tab-weekly" class="tab" type="button" role="tab" aria-selected="false" aria-controls="panel-weekly" tabindex="-1">周刊</button>
      <button id="tab-tools" class="tab" type="button" role="tab" aria-selected="false" aria-controls="panel-tools" tabindex="-1">工具箱</button>
      <button id="tab-about" class="tab" type="button" role="tab" aria-selected="false" aria-controls="panel-about" tabindex="-1">关于我</button>
    </div>
  </div>

  <div id="panel-projects" class="panel panelProjects panelEnter" role="tabpanel" aria-labelledby="tab-projects">
    <article class="projectHitbox">
      <a class="projectCard" href="https://github.com/oppenheimor/oppenheimor.github.io" target="_blank" rel="noreferrer">
        <span class="projectNumber" aria-hidden="true">01</span>
        <div class="projectStage" aria-hidden="true">
          <div class="window">
            <span class="windowDot"></span><span class="windowDot"></span><span class="windowDot"></span>
            <div class="miniGrid"></div>
            <strong>ideas<br />take<br />root.</strong>
            <span class="miniSeed"></span>
          </div>
        </div>
        <div class="projectInfo">
          <span class="eyebrow">DIGITAL GARDEN / 2026</span>
          <h3>This Garden</h3>
          <p>从一个 Hello World 开始，记录技术、产品和生活里正在生长的东西。</p>
          <span class="go">查看源码 <span aria-hidden="true">→</span></span>
        </div>
      </a>
    </article>
    <p class="quietLine">下一件作品还在路上。这里不会用虚构案例填满版面。</p>
  </div>

  <div id="panel-tools" class="panel toolsPanel typeVariant trayVariant" role="tabpanel" aria-labelledby="tab-tools" hidden>
    {toolPreview.length > 0 ? (
      <div class="homeToolDesk">
        {toolPreview.map((tool) => (
          <article class:list={['homeToolFile', { textOnly: !tool.data.cover }]}>
            {tool.data.cover && <button class="fileCover" type="button" data-cover-preview={tool.data.coverFull ?? tool.data.cover} data-cover-name={tool.data.name} aria-label={`放大 ${tool.data.name} 封面`}><img src={tool.data.cover} alt="" width="1200" height="675" loading="lazy" decoding="async" /></button>}
            {!tool.data.cover && <span class="typeCover" aria-hidden="true">/</span>}
            <a class="fileCaption" href={toolPath(tool)}>
              <strong>{tool.data.name}</strong>
              {tool.data.starred && (
                <svg class="fileStar" viewBox="0 0 32 32" role="img" aria-label="已星标">
                  <path d="M17 3 20.5 11.5 30 13 23 19.5 24 29 15.5 24.5 6 28 8 18.5 2 11 12 10Z" />
                </svg>
              )}
            </a>
            <a class="fileSource" href={tool.data.url} target="_blank" rel="noreferrer" aria-label={`访问 ${tool.data.name} 源站（新窗口打开）`}>SOURCE <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    ) : (
      <div class="statement compactStatement">
        <strong>工具已经记下，只是还没有公开摆上桌面。</strong>
      </div>
    )}
    <a class="panelLink" href="/tools">打开工具箱 <span aria-hidden="true">→</span></a>
  </div>

  <div id="panel-writing" class="panel writingPanel" role="tabpanel" aria-labelledby="tab-writing" hidden>
    <a class="articleRow" href="#hello-world">
      <time datetime="2026-09-07">2026.09.07</time>
      <span><strong>Hello World</strong><small>第一篇还没写完，但网站已经先站起来了。</small></span>
      <b aria-hidden="true">→</b>
    </a>
    <p id="hello-world" class="quietLine">文章系统将在下一阶段加入。这个入口暂时诚实地停在首页。</p>
  </div>

  <div id="panel-weekly" class="panel weeklyPanel" role="tabpanel" aria-labelledby="tab-weekly" hidden>
    {latestIssue ? (
      <div class="weeklyStage">
        <div class="weeklyTide" aria-hidden="true">
          <svg viewBox="0 0 1000 240" preserveAspectRatio="none">
            <path class="tideBack" d="M0 126C146 57 284 58 424 123c147 68 302 106 576-16v133H0Z" />
            <path class="tideFront" d="M0 166c154-71 286-38 432 14 166 59 321 42 568-45v188H0Z" />
          </svg>
        </div>
        <div class="weeklyCarousel" data-weekly-carousel>
          <button class="weeklyArrow weeklyArrowPrev" type="button" data-weekly-prev aria-label="上一期" disabled={weeklyIssues.length <= 1}>←</button>
          <div class="weeklyViewport">
            <div class="weeklyTrack" data-weekly-track>
              {weeklyPages.map((page) => (
                <div class="weeklyPage" data-weekly-page>
                  {page.map((issue) => (
                    <a class:list={['weeklyIssueCard', { isCurrent: issue.id === latestIssue.id }]} href={weeklyPath(issue)} data-weekly-slide>
                      <span class="weeklyCardSurface">
                        <span class="weeklyCardCover"><img data-weekly-cover={issue.id} src={issue.data.cover} alt="" width="1200" height="675" loading="lazy" decoding="async" /></span>
                        <span class="weeklyCardCaption">
                          <span class="weeklyCardMeta">
                            <b>{issueLabel(issue.data.vol)}</b>
                            <time datetime={issue.data.date.toISOString().slice(0, 10)}>{issueDate(issue.data.date)}</time>
                          </span>
                          <strong>{issue.data.title}</strong>
                          <span class="weeklyCardSummary">{issue.data.summary}</span>
                          <span class="weeklyCardAction" aria-hidden="true">↗</span>
                        </span>
                      </span>
                      <span class="weeklyCardReflection" aria-hidden="true"><img src={issue.data.cover} alt="" width="1200" height="675" loading="lazy" decoding="async" /></span>
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>
          <button class="weeklyArrow weeklyArrowNext" type="button" data-weekly-next aria-label="下一期" disabled={weeklyIssues.length <= 1}>→</button>
          {weeklyPages.length > 1 && <span class="weeklyProgress" data-weekly-progress>01 / {String(weeklyPages.length).padStart(2, '0')}</span>}
        </div>
      </div>
    ) : (
      <div class="statement compactStatement">
        <strong>周刊还没到第一期。</strong>
      </div>
    )}
  </div>

  <div id="panel-about" class="panel textPanel" role="tabpanel" aria-labelledby="tab-about" hidden>
    <p class="panelKicker">OPPENHEIMOR / ABOUT</p>
    <div class="statement">
      <strong>一个在代码、产品与日常之间持续学习的人。</strong>
      <p>这里是我的公开数字花园。完整经历和真实姓名会在准备好后补进来，现在先让作品与思考说话。</p>
    </div>
    <ul class="tags" aria-label="关注领域">
      <li>ENGINEERING</li><li>PRODUCT</li><li>AI</li><li>LIFE</li>
    </ul>
  </div>
</section>

<script>
  const initGardenTabs = () => {
    const garden = document.querySelector<HTMLElement>('#garden');
    if (!garden || garden.dataset.initialized === 'true') return;
    garden.dataset.initialized = 'true';

    const tabs = Array.from(garden.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const tabsDock = document.querySelector<HTMLElement>('[data-tabs-dock]');
  const tabsSentinel = document.querySelector<HTMLElement>('[data-tabs-sentinel]');

  if (tabsDock && tabsSentinel && 'IntersectionObserver' in window) {
    const stickyObserver = new IntersectionObserver(([entry]) => {
      const isStuck = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      tabsDock.classList.toggle('isStuck', isStuck);
    }, { rootMargin: '-1px 0px 0px', threshold: 0 });
    stickyObserver.observe(tabsSentinel);
  }

  const selectTab = (selected: HTMLButtonElement, shouldScroll = true, shouldPersist = true) => {
    tabs.forEach((tab) => {
      const active = tab === selected;
      tab.classList.toggle('isActive', active);
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
      const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
      if (panel) {
        panel.hidden = !active;
        panel.classList.toggle('panelEnter', active);
      }
    });
    if (shouldPersist) {
      const currentState = typeof history.state === 'object' && history.state !== null ? history.state : {};
      history.replaceState({ ...currentState, gardenTab: selected.id }, '');
    }
    if (shouldScroll) selected.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectTab(tab));
    tab.addEventListener('keydown', (event) => {
      let next = index;
      if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      else return;
      event.preventDefault();
      tabs[next].focus();
      selectTab(tabs[next]);
    });
  });

  const requestedTab = new URLSearchParams(location.search).get('garden');
  const savedTab = tabs.find((tab) => tab.id === history.state?.gardenTab) ?? (requestedTab ? tabs.find((tab) => tab.id === `tab-${requestedTab}`) : undefined);
  if (savedTab) selectTab(savedTab, false, false);

  const weeklyTrack = document.querySelector<HTMLElement>('[data-weekly-track]');
  const weeklyPages = weeklyTrack ? Array.from(weeklyTrack.querySelectorAll<HTMLElement>('[data-weekly-page]')) : [];
  const weeklyProgress = document.querySelector<HTMLElement>('[data-weekly-progress]');
  const weeklyPrev = document.querySelector<HTMLButtonElement>('[data-weekly-prev]');
  const weeklyNext = document.querySelector<HTMLButtonElement>('[data-weekly-next]');

  if (weeklyTrack && weeklyPages.length > 1) {
    const getPageWidth = () => weeklyTrack.clientWidth;
    const getPageIndex = () => {
      const pageWidth = getPageWidth();
      return pageWidth === 0 ? 0 : Math.min(weeklyPages.length - 1, Math.max(0, Math.round(weeklyTrack.scrollLeft / pageWidth)));
    };

    const updateWeeklyState = () => {
      const pageIndex = getPageIndex();
      weeklyPages.forEach((page, index) => {
        page.classList.toggle('isCurrent', index === pageIndex);
        page.querySelectorAll<HTMLElement>('[data-weekly-slide]').forEach((slide, slideIndex) => slide.classList.toggle('isCurrent', index === pageIndex && slideIndex === 0));
      });
      if (weeklyProgress) weeklyProgress.textContent = `${String(pageIndex + 1).padStart(2, '0')} / ${String(weeklyPages.length).padStart(2, '0')}`;
      if (weeklyPrev) weeklyPrev.disabled = pageIndex === 0;
      if (weeklyNext) weeklyNext.disabled = pageIndex === weeklyPages.length - 1;
    };

    const scrollWeekly = (direction: number) => {
      const targetPage = Math.min(weeklyPages.length - 1, Math.max(0, getPageIndex() + direction));
      weeklyTrack.scrollTo({ left: targetPage * getPageWidth(), behavior: 'smooth' });
    };

    let updateFrame = 0;
    const scheduleWeeklyStateUpdate = () => {
      if (updateFrame) return;
      updateFrame = window.requestAnimationFrame(() => {
        updateFrame = 0;
        updateWeeklyState();
      });
    };

    weeklyPrev?.addEventListener('click', () => scrollWeekly(-1));
    weeklyNext?.addEventListener('click', () => scrollWeekly(1));
    weeklyTrack.addEventListener('scroll', scheduleWeeklyStateUpdate, { passive: true });
    window.addEventListener('resize', scheduleWeeklyStateUpdate);
    document.querySelector('#tab-weekly')?.addEventListener('click', scheduleWeeklyStateUpdate);
    updateWeeklyState();
  }

    garden.querySelectorAll<HTMLAnchorElement>('[data-weekly-slide]').forEach((link) => {
      link.addEventListener('click', () => {
        const image = link.querySelector<HTMLImageElement>('[data-weekly-cover]');
        if (!image) return;
        const rect = image.getBoundingClientRect();
        sessionStorage.setItem('weekly-cover-origin', JSON.stringify({ top: rect.top, left: rect.left, width: rect.width, height: rect.height }));
      });
    });
  };

  document.addEventListener('astro:page-load', initGardenTabs);
  initGardenTabs();
</script>

<style>
  .garden {
    position: relative;
    padding: 12vh 0;
  }

  .visuallyHidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .sectionNumber {
    position: absolute;
    top: 5vh;
    right: -0.05em;
    z-index: -1;
    display: flex;
    color: transparent;
    font-size: clamp(120px, 22vw, 220px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    -webkit-text-stroke: 1px oklch(0.72 0.08 245 / 0.16);
    user-select: none;
  }

  .tabsSentinel {
    display: block;
    height: 1px;
    margin-bottom: -1px;
    pointer-events: none;
  }

  .tabsDock {
    position: sticky;
    top: calc(env(safe-area-inset-top, 0px) + 18px);
    z-index: 10;
    isolation: isolate;
    margin-bottom: 48px;
  }

  .tabsDock::before {
    position: absolute;
    top: calc(-18px - env(safe-area-inset-top, 0px));
    bottom: -26px;
    left: 50%;
    z-index: -1;
    width: 100vw;
    background: linear-gradient(
      to bottom,
      var(--canvas) 0%,
      var(--canvas) 72%,
      oklch(0.125 0.032 264 / 0.78) 86%,
      oklch(0.125 0.032 264 / 0) 100%
    );
    backdrop-filter: blur(10px) saturate(0.86);
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%);
    transition: opacity 0.45s var(--ease-out);
    -webkit-backdrop-filter: blur(10px) saturate(0.86);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 82%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 0%, black 82%, transparent 100%);
  }

  .tabsDock.isStuck::before { opacity: 1; }

  .tabs {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    gap: 42px;
    width: 100%;
    padding: 0 0 16px;
  }

  .tab {
    position: relative;
    display: flex;
    flex: none;
    min-height: 1.16em;
    align-items: flex-end;
    padding: 0 0 10px;
    border: 0;
    background: transparent;
    color: oklch(0.57 0.035 245);
    cursor: pointer;
    font-size: clamp(30px, 5.2vw, 48px);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.03em;
    opacity: 0.76;
    transition: color 0.6s var(--ease-out), opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
  }

  .tab::after {
    position: absolute;
    bottom: 2px;
    left: -2%;
    z-index: -1;
    width: 104%;
    height: 0.32em;
    background: var(--highlight);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s var(--ease-out);
  }

  .tab.isActive {
    color: var(--ink);
    opacity: 1;
  }

  .tab.isActive::after { transform: scaleX(1); }

  .panel[hidden] { display: none; }

  .panelEnter { animation: panelIn 0.9s var(--ease-out); }

  @keyframes panelIn {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .panelProjects {
    display: grid;
    gap: 16px;
  }

  .projectCard {
    position: relative;
    display: grid;
    min-height: 300px;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: 36px;
    padding: 22px 26px;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 20px;
    background: var(--canvas);
    color: inherit;
    text-decoration: none;
    transition: transform 0.45s var(--ease-out), box-shadow 0.7s var(--ease-out), border-color 0.7s var(--ease-out);
  }

  .projectNumber {
    position: absolute;
    bottom: 18px;
    left: 28px;
    color: transparent;
    font-size: 42px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    -webkit-text-stroke: 1px oklch(0.72 0.08 245 / 0.18);
    transition: transform 0.9s var(--ease-out);
  }

  .projectStage,
  .projectInfo { position: relative; z-index: 1; }

  .window {
    position: relative;
    height: 202px;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 14px;
    background: var(--highlight-soft);
    box-shadow: 0 18px 35px var(--shadow);
    transform: rotate(-2deg);
    transition: transform 0.7s var(--ease-out);
  }

  .windowDot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin: 12px 0 0 6px;
    border-radius: 50%;
    background: var(--text-muted);
  }

  .windowDot:first-child { margin-left: 13px; background: var(--signal); }

  .miniGrid {
    position: absolute;
    inset: 30px 0 0;
    background-image:
      linear-gradient(oklch(0.82 0.04 245 / 0.09) 1px, transparent 1px),
      linear-gradient(90deg, oklch(0.82 0.04 245 / 0.09) 1px, transparent 1px);
    background-size: 18px 18px;
  }

  .window strong {
    position: absolute;
    top: 52px;
    left: 24px;
    font-size: 38px;
    line-height: 0.88;
    letter-spacing: -0.06em;
  }

  .miniSeed {
    position: absolute;
    right: 34px;
    bottom: 43px;
    width: 35px;
    height: 35px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--highlight);
    box-shadow: 18px -18px 0 -12px var(--signal);
  }

  .eyebrow,
  .panelKicker {
    color: var(--text-muted);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
  }

  .projectInfo h3 {
    margin: 14px 0 12px;
    font-size: clamp(30px, 4vw, 40px);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .projectInfo p {
    max-width: 31ch;
    margin: 0 0 28px;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.75;
  }

  .go {
    font-size: 12px;
    letter-spacing: 0.08em;
  }

  .go span {
    display: inline-block;
    margin-left: 6px;
    transition: transform 0.5s var(--ease-out);
  }

  .quietLine {
    margin: 16px 4px 0;
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.7;
  }

  .textPanel,
  .toolsPanel {
    min-height: 510px;
    padding: 60px 0 20px;
  }

  .toolsPanel { min-height: 0; padding-top: 12px; }

  .homeToolDesk {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    padding: 1px;
    background: var(--hairline);
  }

  .homeToolFile {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    padding: 24px;
    background: var(--canvas);
    color: var(--ink);
    text-decoration: none;
  }
  .homeToolFile:focus-visible { position: relative; z-index: 1; outline-offset: -4px; }
  .fileCover { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: contain; }
  .fileCaption { display: flex; justify-content: space-between; align-items: center; gap: 16px; transition: transform 0.4s var(--ease-out); }
  .fileCaption strong { min-width: 0; font-size: clamp(22px, 3vw, 28px); letter-spacing: -0.04em; overflow-wrap: anywhere; }
  .fileStar {
    flex: none;
    width: 26px;
    height: 26px;
    overflow: visible;
    color: var(--highlight);
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linejoin: round;
    transform: rotate(-9deg);
    transition: transform 0.5s var(--ease-out);
  }
  .textOnly { justify-content: center; }
  .textOnly .fileCaption strong { font-size: clamp(30px, 4vw, 42px); }
  .homeToolFile:focus-visible .fileCaption { transform: translateY(-2px); }

  .typeVariant .homeToolDesk {
    gap: 20px 42px;
    padding: 16px 0 32px;
    background: transparent;
    align-items: start;
  }
  .typeVariant .homeToolFile {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    min-height: 205px;
    gap: 0;
    padding: 24px 0;
    background: transparent;
    isolation: isolate;
  }
  .typeVariant .homeToolFile:nth-child(even) { margin-top: 76px; }
  .typeVariant .fileCover {
    grid-column: 2;
    grid-row: 1;
    width: 115%;
    max-width: none;
    margin-left: -15%;
    aspect-ratio: 4 / 3;
    border-radius: 7px;
    object-fit: contain;
    background: var(--surface);
    box-shadow: 0 18px 30px -18px var(--shadow);
    transform: rotate(5deg) translateY(-24px);
    transition: transform 0.6s var(--ease-out);
  }
  .typeVariant .homeToolFile:nth-child(even) .fileCover { transform: rotate(-5deg) translateY(-24px); }
  .typeVariant .fileCaption {
    position: relative;
    z-index: 1;
    grid-column: 1 / -1;
    grid-row: 1;
    justify-content: flex-start;
    align-self: end;
    gap: 10px;
    padding: 0 0 2px;
    transform: none;
  }
  .typeVariant .fileCaption strong {
    position: relative;
    font-size: clamp(35px, 4.6vw, 52px);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }
  .typeVariant .fileCaption strong::after {
    position: absolute;
    z-index: -1;
    right: -3px;
