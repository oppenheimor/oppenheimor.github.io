---
import { getCollection, render } from 'astro:content';
import SiteBackdrop from '../../components/home/SiteBackdrop.astro';
import SubHeader from '../../components/SubHeader.astro';
import { tracePlatform } from '../../lib/tools';
import '../../styles/global.css';

export async function getStaticPaths() {
  const tools = await getCollection('tools', ({ data }) => data.published);
  return tools.map((tool) => ({ params: { id: tool.id }, props: { tool } }));
}

const { tool } = Astro.props;
const { Content } = await render(tool);
const hasIntroduction = Boolean(tool.body?.trim());
const hostname = new URL(tool.data.url).hostname.replace(/^www\./, '');
const title = `${tool.data.name} — 工具箱 — Oppenheimor`;
const description = `${tool.data.name} 的工具档案与使用痕迹。`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111111" />
    <link rel="icon" href="/favicon-cat.png?v=2" type="image/png" />
    <title>{title}</title>
  </head>
  <body>
    <SiteBackdrop />
    <div class="site-column detailColumn">
      <SubHeader section="tools" />
      <main>
        <a class="backLink" href="/tools"><span aria-hidden="true">←</span> 返回工具箱</a>

        <header class:list={['toolHeading', { isRetired: tool.data.retired }]}>
          <div class="headingMeta">
            <span>TOOL FILE / {tool.data.addedAt.toISOString().slice(0, 10).replaceAll('-', '.')}</span>
            {tool.data.starred && <strong aria-label="已星标">★ STARRED</strong>}
            {tool.data.retired && <strong>已划掉</strong>}
          </div>
          <h1>{tool.data.name}</h1>
          <div class="headingFoot">
            {tool.data.tags.length > 0 ? (
              <ul aria-label="标签">{tool.data.tags.map((tag) => <li>{tag}</li>)}</ul>
            ) : <span></span>}
            <a href={tool.data.url} target="_blank" rel="noreferrer">{hostname} <span aria-hidden="true">↗</span></a>
          </div>
        </header>

        {tool.data.cover && <button class="toolCover" type="button" data-cover-preview={tool.data.coverFull ?? tool.data.cover} data-cover-name={tool.data.name} aria-label={`放大 ${tool.data.name} 封面`}><img src={tool.data.cover} alt={`${tool.data.name} 封面`} width="1200" height="675" decoding="async" /></button>}

        <section class="folder" aria-label={`${tool.data.name} 工具档案`}>
          <div class="folderTabs" role="tablist" aria-label="档案内容">
            <button id="tab-traces" class="folderTab isActive" type="button" role="tab" aria-selected="true" aria-controls="panel-traces" tabindex="0">
              使用痕迹 <span>{String(tool.data.traces.length).padStart(2, '0')}</span>
            </button>
            <button id="tab-introduction" class="folderTab" type="button" role="tab" aria-selected="false" aria-controls="panel-introduction" tabindex="-1">
              工具介绍 <span>{hasIntroduction ? 'READ' : 'EMPTY'}</span>
            </button>
          </div>

          <div class="sheetStack">
            <div id="panel-traces" class="sheet sheetTraces sheetEnter" role="tabpanel" aria-labelledby="tab-traces">
              <p class="sheetLabel">PUBLIC TRACES / 使用痕迹</p>
              {tool.data.traces.length > 0 ? (
                <ol class="traceList">
                  {tool.data.traces.map((trace, index) => (
                    <li>
                      <a href={trace} target="_blank" rel="noreferrer">
                        <span class="traceIndex">{String(index + 1).padStart(2, '0')}</span>
                        <strong>{tracePlatform(trace)}</strong>
                        <span class="traceUrl">{trace}</span>
                        <b aria-hidden="true">↗</b>
                      </a>
                    </li>
                  ))}
                </ol>
              ) : (
                <div class="emptySheet">
                  <span aria-hidden="true">○</span>
                  <p>还没有留下公开的使用痕迹。</p>
                </div>
              )}
            </div>

            <div id="panel-introduction" class="sheet sheetIntroduction" role="tabpanel" aria-labelledby="tab-introduction" hidden>
              <p class="sheetLabel">ABOUT THIS TOOL / 工具介绍</p>
              {hasIntroduction ? <article class="introContent"><Content /></article> : (
                <div class="emptySheet">
                  <span aria-hidden="true">□</span>
                  <p>这份工具介绍还是空白。</p>
                </div>
              )}
            </div>
          </div>
        </section>
      </main>
      <footer><span>© {year} OPPENHEIMOR®</span><a href="/tools">工具箱目录</a></footer>
    </div>

    <script>
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.folderTab'));
      const selectTab = (selected: HTMLButtonElement) => {
        tabs.forEach((tab) => {
          const active = tab === selected;
          tab.classList.toggle('isActive', active);
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
          if (panel) {
            panel.hidden = !active;
            panel.classList.toggle('sheetEnter', active);
          }
        });
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectTab(tab));
        tab.addEventListener('keydown', (event) => {
          let next = index;
          if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = tabs.length - 1;
          else return;
          event.preventDefault();
          tabs[next].focus();
          selectTab(tabs[next]);
        });
      });
    </script>
  </body>
</html>

<style>
  .detailColumn { max-width: 1040px; }
  .backLink {
    display: inline-flex;
    gap: 10px;
    margin-top: clamp(70px, 11vh, 120px);
    color: var(--text-muted);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .toolHeading { padding: 30px 0 clamp(55px, 9vh, 92px); }
  .headingMeta,
  .headingFoot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    color: var(--text-muted);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
  }
  .headingMeta strong { color: var(--ink); font-weight: 500; }
  .headingMeta strong:first-of-type { padding: 3px 7px; background: var(--highlight); }

  h1 {
    max-width: 12ch;
    margin: 28px 0 34px;
    font-size: clamp(68px, 13vw, 140px);
    line-height: 0.88;
    letter-spacing: -0.07em;
    overflow-wrap: anywhere;
  }
  .isRetired h1 { color: var(--text-muted); text-decoration: line-through; text-decoration-thickness: 0.075em; }

  .headingFoot { align-items: center; }
  .headingFoot ul { display: flex; flex-wrap: wrap; gap: 7px; margin: 0; padding: 0; list-style: none; }
  .headingFoot li { padding: 7px 10px; border: 1px solid var(--hairline); border-radius: 999px; }
  .headingFoot a { color: var(--text-secondary); text-decoration: none; }

  .toolCover { display: block; width: min(82%, 760px); margin: -25px auto 90px; padding: 0; border: 1px solid var(--hairline); background: transparent; cursor: pointer; box-shadow: 0 30px 60px -45px var(--shadow); transform: rotate(-0.6deg); }
  .toolCover img { display: block; width: 100%; max-height: 480px; border-radius: 10px; object-fit: cover; }
  button.toolCover { border-radius: 10px; }

  .folder { position: relative; margin-bottom: 8vh; padding-top: 54px; }
  .folder::before {
    position: absolute;
    top: 42px;
    right: -12px;
    bottom: -12px;
    left: 14px;
    z-index: -2;
    border: 1px solid var(--hairline);
    background: var(--surface-raised);
    content: "";
    transform: rotate(0.55deg);
  }

  .folderTabs { position: absolute; top: 0; left: 16px; z-index: 2; display: flex; align-items: flex-end; gap: 5px; }
  .folderTab {
    min-width: 170px;
    padding: 15px 18px 18px;
    border: 1px solid var(--hairline);
    border-bottom: 0;
    border-radius: 9px 9px 0 0;
    background: var(--highlight-soft);
    color: var(--text-secondary);
    cursor: pointer;
    text-align: left;
    transition: padding 0.45s var(--ease-out), background 0.45s var(--ease-out), color 0.45s var(--ease-out);
  }
  .folderTab span { display: block; margin-top: 7px; color: var(--text-muted); font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 9px; letter-spacing: 0.12em; }
  .folderTab.isActive { z-index: 2; padding-top: 21px; background: var(--surface-raised); color: var(--ink); }

  .sheetStack { position: relative; min-height: 520px; }
  .sheet {
    min-height: 520px;
    padding: clamp(34px, 6vw, 66px);
    border: 1px solid var(--hairline);
    background: var(--surface-raised);
    box-shadow: 0 26px 60px -48px var(--shadow);
  }
  .sheet[hidden] { display: none; }
  .sheetEnter { animation: sheetIn 0.65s var(--ease-out); }
  @keyframes sheetIn { from { opacity: 0.55; transform: translateY(8px) rotate(-0.15deg); } to { opacity: 1; transform: translateY(0) rotate(0); } }

  .sheetLabel { margin: 0 0 48px; color: var(--text-muted); font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 10px; letter-spacing: 0.14em; }
  .traceList { margin: 0; padding: 0; list-style: none; }
  .traceList li { border-top: 1px solid var(--hairline); }
  .traceList li:last-child { border-bottom: 1px solid var(--hairline); }
  .traceList a { display: grid; grid-template-columns: 44px 90px minmax(0, 1fr) 20px; gap: 18px; align-items: center; padding: 25px 4px; color: inherit; text-decoration: none; transition: padding 0.45s var(--ease-out), background 0.45s var(--ease-out); }
  .traceIndex { color: var(--text-muted); font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 10px; }
  .traceList strong { font-size: 20px; }
  .traceUrl { overflow: hidden; color: var(--text-secondary); font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
  .traceList b { font-size: 17px; font-weight: 400; }

  .emptySheet { display: grid; min-height: 320px; place-content: center; color: var(--text-muted); text-align: center; }
  .emptySheet span { color: var(--highlight); font-size: 70px; line-height: 1; -webkit-text-stroke: 1px var(--ink); }
  .emptySheet p { margin: 22px 0 0; }

  .introContent { max-width: 70ch; margin: 0 auto; color: var(--text-secondary); font-size: 16px; line-height: 1.9; }
  .introContent :global(h2),
  .introContent :global(h3) { color: var(--ink); line-height: 1.15; letter-spacing: -0.035em; }
  .introContent :global(h2) { margin: 1.6em 0 0.65em; font-size: clamp(31px, 5vw, 48px); }
  .introContent :global(h3) { margin: 1.7em 0 0.6em; font-size: 24px; }
  .introContent :global(p),
  .introContent :global(ul),
  .introContent :global(ol) { margin: 0 0 1.25em; }
  .introContent :global(a) { text-decoration-color: var(--highlight); text-decoration-thickness: 0.2em; text-underline-offset: 0.14em; }
  .introContent :global(img) { max-width: 100%; height: auto; border: 1px solid var(--hairline); }
  .introContent :global(pre) { padding: 18px; overflow-x: auto; background: oklch(0.13 0.004 90); font-size: 13px; line-height: 1.6; }
  .introContent :global(code) { font-family: ui-monospace, "SF Mono", Menlo, monospace; }

  footer a { color: inherit; text-decoration: none; }

  @media (hover: hover) and (pointer: fine) {
    .traceList a:hover { padding-right: 14px; padding-left: 14px; background: var(--highlight-soft); }
    .folderTab:not(.isActive):hover { padding-top: 19px; color: var(--ink); }
  }

  @media (max-width: 700px) {
    .backLink { margin-top: 58px; }
    h1 { font-size: clamp(62px, 20vw, 94px); }
    .toolCover { width: 94%; margin-bottom: 65px; }
    .folder { padding-top: 47px; }
    .folderTabs { left: 8px; width: calc(100% - 16px); }
    .folderTab { min-width: 0; flex: 1; padding: 12px 10px 15px; font-size: 13px; }
    .folderTab.isActive { padding-top: 17px; }
    .sheet { min-height: 470px; padding: 31px 20px; }
    .sheetLabel { margin-bottom: 34px; }
    .traceList a { grid-template-columns: 34px 1fr 18px; gap: 10px; }
    .traceUrl { grid-column: 2 / 3; font-size: 10px; }
    .traceList b { grid-column: 3; grid-row: 1 / 3; }
    .introContent { font-size: 15px; }
  }
</style>
