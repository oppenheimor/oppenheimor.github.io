---
import { getCollection } from 'astro:content';
import SiteBackdrop from '../../components/home/SiteBackdrop.astro';
import SubHeader from '../../components/SubHeader.astro';
import { groupWeeklyByYear, issueDate, issueNumber, sortWeekly, weeklyPath } from '../../lib/weekly';
import '../../styles/global.css';

const issues = sortWeekly(await getCollection('weekly', ({ data }) => data.published));
const years = groupWeeklyByYear(issues);
const latest = issues[0] ?? null;
const title = '周刊 — Oppenheimor';
const description = 'Oppenheimor 的周刊：每周记下用过的工具、读过的东西和这一周真实发生的事。';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c1426" />
    <title>{title}</title>
  </head>
  <body>
    <SiteBackdrop />
    <div class="site-column weeklyColumn">
      <SubHeader section="weekly" />
      <main>
        <header class="weeklyHero">
          <div class="heroTitle">
            <h1>周刊</h1>
            {latest && <span aria-label={`已发布 ${issues.length} 期`}>{issueNumber(latest.data.vol)}</span>}
          </div>
          <p>每周一发布。用过的工具、读过的东西，和这一周真实发生的事。</p>
        </header>

        {issues.length > 0 ? (
          <section class="ledger" aria-label="周刊归档">
            {years.map((group) => (
              <div class="yearGroup">
                <p class="yearHead">
                  <span>{group.year}</span>
                  <b>{String(group.items.length).padStart(2, '0')} 期</b>
                </p>
                <ol class="issueList">
                  {group.items.map((issue) => (
                    <li>
                      <a class="issueRow" href={weeklyPath(issue)}>
                        <span class="rowVol" aria-hidden="true">{issueNumber(issue.data.vol)}</span>
                        <span class="rowCover">
                          <img src={issue.data.cover} alt="" loading="lazy" />
                        </span>
                        <span class="rowBody">
                          <span class="rowMeta">
                            <time datetime={issue.data.date.toISOString().slice(0, 10)}>{issueDate(issue.data.date)}</time>
                            {issue.data.tags.map((tag) => <span>{tag}</span>)}
                          </span>
                          <strong>{issue.data.title}</strong>
                          <span class="rowSummary">{issue.data.summary}</span>
                        </span>
                        <span class="rowArrow" aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </section>
        ) : (
          <section class="emptyLedger" aria-label="空周刊">
            <p>周刊还没到第一期。第一期写完之前，这里不会放占位内容。</p>
          </section>
        )}
      </main>
      <footer><span>© {year} OPPENHEIMOR®</span><a href="/">回到首页</a></footer>
    </div>
  </body>
</html>

<style>
  .weeklyColumn { max-width: 1040px; }

  .weeklyHero {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(240px, 0.6fr);
    gap: clamp(38px, 7vw, 92px);
    align-items: end;
    padding: clamp(80px, 13vh, 132px) 0 clamp(56px, 9vh, 88px);
  }

  .heroTitle { position: relative; width: fit-content; }
  h1 {
    margin: 0;
    font-size: clamp(78px, 12vw, 136px);
    font-weight: 700;
    line-height: 0.82;
    letter-spacing: -0.075em;
  }
  .heroTitle > span {
    position: absolute;
    top: -1.6em;
    right: -2.4em;
    color: var(--signal);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
  }
  .weeklyHero > p {
    max-width: 30ch;
    margin: 0 0 2px;
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.8;
  }

  .ledger { padding-bottom: 8vh; }

  .yearGroup + .yearGroup { margin-top: 74px; }

  .yearHead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin: 0;
    padding-bottom: 14px;
    color: var(--text-muted);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
  }
  .yearHead b { color: var(--text-muted); font-weight: 400; letter-spacing: 0.12em; }

  .issueList { margin: 0; padding: 0; list-style: none; }

  .issueRow {
    display: grid;
    grid-template-columns: 72px 244px minmax(0, 1fr) 22px;
    align-items: center;
    gap: 32px;
    padding: 34px 4px;
    border-top: 1px solid var(--hairline);
    color: inherit;
    text-decoration: none;
    transition: background 0.5s var(--ease-out);
  }
  .issueList li:last-child .issueRow { border-bottom: 1px solid var(--hairline); }

  .rowVol {
    align-self: start;
    padding-top: 4px;
    color: transparent;
    font-size: clamp(38px, 4.6vw, 54px);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.05em;
    -webkit-text-stroke: 1px oklch(0.72 0.08 245 / 0.34);
    transition: -webkit-text-stroke-color 0.5s var(--ease-out);
  }

  .rowCover {
    display: block;
    overflow: hidden;
    border: 1px solid var(--hairline);
    background: var(--surface);
    aspect-ratio: 3 / 2;
    box-shadow: 0 22px 40px -34px var(--shadow);
    transform: rotate(-0.9deg);
    transition: transform 0.75s var(--ease-out), border-color 0.6s var(--ease-out);
  }
  .issueList li:nth-child(even) .rowCover { transform: rotate(0.9deg); }
  .rowCover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease-out);
  }

  .rowBody { display: block; min-width: 0; }

  .rowMeta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    color: var(--text-muted);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
  }
  .rowMeta span {
    padding: 3px 8px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
  }

  .rowBody strong {
    position: relative;
    display: block;
    width: fit-content;
    max-width: 100%;
    margin: 14px 0 0;
    font-size: clamp(26px, 3.4vw, 36px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.045em;
  }
  .rowBody strong::after {
    position: absolute;
    right: -3px;
    bottom: -2px;
    left: -3px;
    z-index: -1;
    height: 0.2em;
    background: var(--highlight);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.55s var(--ease-out);
  }

  .rowSummary {
    display: -webkit-box;
    max-width: 52ch;
    overflow: hidden;
    margin-top: 12px;
    color: var(--text-secondary);
    font-size: 13.5px;
    line-height: 1.8;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .rowArrow {
    color: var(--ink);
    font-size: 20px;
    opacity: 0.28;
    transition: opacity 0.5s var(--ease-out), transform 0.6s var(--ease-out);
  }

  .emptyLedger {
    min-height: 300px;
    padding: 84px 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    color: var(--text-muted);
    text-align: center;
  }

  footer a { color: inherit; text-decoration: none; }

  @media (hover: hover) and (pointer: fine) {
    .issueRow:hover { background: oklch(0.17 0.038 267 / 0.62); }
    .issueRow:hover .rowVol { -webkit-text-stroke-color: var(--highlight); }
    .issueRow:hover .rowCover { border-color: oklch(0.48 0.11 250); transform: rotate(0deg); }
    .issueRow:hover .rowCover img { transform: scale(1.04); }
    .issueRow:hover .rowBody strong::after { transform: scaleX(1); }
    .issueRow:hover .rowArrow { opacity: 1; transform: translateX(6px); }
  }

  @media (max-width: 860px) {
    .issueRow {
      grid-template-columns: 48px 200px minmax(0, 1fr) 18px;
      gap: 22px;
    }
  }

  @media (max-width: 700px) {
    .weeklyHero {
      grid-template-columns: 1fr;
      gap: 34px;
      padding: 78px 0 58px;
    }
    h1 { font-size: clamp(72px, 23vw, 104px); }
    .heroTitle > span { top: -1.4em; right: -2em; }
    .weeklyHero > p { max-width: 31ch; font-size: 14px; }

    .yearHead { padding-bottom: 10px; }
    .yearGroup + .yearGroup { margin-top: 54px; }

    .issueRow {
      grid-template-columns: 116px minmax(0, 1fr);
      gap: 18px;
      padding: 22px 0;
    }
    .rowVol { display: none; }
    .rowArrow { display: none; }
    .rowCover { transform: none; }
    .issueList li:nth-child(even) .rowCover { transform: none; }
    .rowMeta { gap: 8px; font-size: 9px; }
    .rowMeta span { padding: 2px 6px; }
    .rowBody strong { margin-top: 10px; font-size: clamp(21px, 6.4vw, 28px); }
    .rowSummary { margin-top: 9px; font-size: 12.5px; line-height: 1.7; -webkit-line-clamp: 3; }
  }
</style>
