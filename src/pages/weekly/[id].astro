---
import { getCollection, render } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import SiteBackdrop from '../../components/home/SiteBackdrop.astro';
import CatWatermark from '../../components/CatWatermark.astro';
import WeeklyOutline from '../../components/WeeklyOutline.astro';
import { issueLabel, sortWeekly } from '../../lib/weekly';
import '../../styles/global.css';

export async function getStaticPaths() {
  const issues = sortWeekly(await getCollection('weekly', ({ data }) => data.published));
  return issues.map((issue) => ({ params: { id: issue.id }, props: { issue } }));
}

const { issue } = Astro.props;
const { Content, headings } = await render(issue);
const title = `${issueLabel(issue.data.vol)} ${issue.data.title} — 周刊 — Oppenheimor`;
const description = issue.data.summary;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111111" />
    <ClientRouter />
    <link rel="icon" href="/favicon-cat.png?v=2" type="image/png" />
    <title>{title}</title>
  </head>
  <body>
    <SiteBackdrop showProgress={false} />
    <CatWatermark compact />
    <WeeklyOutline headings={headings} />
    <div class="site-column weeklyReader">
      <main>
        <article class="weeklyArticle">
          <header class="articleHeader" data-weekly-entrance="header">
            <a class="homeLink" href="/?garden=weekly#garden" aria-label="返回首页">
              <svg class="homeLinkIcon" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M10.5 3.5 6 8l4.5 4.5M6.5 8H14" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" />
              </svg>
              <span>返回首页</span>
            </a>
            <h1>{issueLabel(issue.data.vol)} - {issue.data.title}</h1>
          </header>

          <figure class="articleCover">
            <img data-weekly-cover-target src={issue.data.coverFull ?? issue.data.cover} alt={`${issueLabel(issue.data.vol)} ${issue.data.title} 封面`} />
          </figure>

          <p class="articleSummary" data-weekly-entrance="summary">{issue.data.summary}</p>

          <div class="markdownContent" data-weekly-entrance="body">
            <Content />
          </div>
        </article>
      </main>
    </div>

    <script>
      const runWeeklyCoverEntrance = () => {
        const target = document.querySelector<HTMLImageElement>('[data-weekly-cover-target]');
        const entranceItems = Array.from(document.querySelectorAll<HTMLElement>('[data-weekly-entrance]'));
        const rawOrigin = sessionStorage.getItem('weekly-cover-origin');
        if (!target || !rawOrigin) return;
        sessionStorage.removeItem('weekly-cover-origin');
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            sessionStorage.removeItem('weekly-cover-origin');
            return;
          }
          const origin = JSON.parse(rawOrigin) as { top: number; left: number; width: number; height: number };
          const rect = target.getBoundingClientRect();
          const scaleX = origin.width / rect.width;
          const scaleY = origin.height / rect.height;
          target.style.opacity = '0';
          target.animate([
            { opacity: 0.86, transformOrigin: 'top left', transform: `translate(${origin.left - rect.left}px, ${origin.top - rect.top}px) scale(${scaleX}, ${scaleY})` },
            { opacity: 1, transformOrigin: 'top left', transform: 'translate(0, 0) scale(1)' },
          ], { duration: 820, easing: 'cubic-bezier(0.19, 1, 0.22, 1)', fill: 'both' });
          entranceItems.forEach((item, index) => {
            item.animate([
              { opacity: 0, transform: 'translateY(20px)' },
              { opacity: 1, transform: 'translateY(0)' },
            ], { duration: 620, delay: 260 + index * 110, easing: 'cubic-bezier(0.19, 1, 0.22, 1)', fill: 'both' });
          });
        } catch {
          sessionStorage.removeItem('weekly-cover-origin');
        }
      };
      document.addEventListener('astro:page-load', runWeeklyCoverEntrance);
      runWeeklyCoverEntrance();
    </script>
  </body>
</html>

<style>
  .weeklyReader { max-width: 1360px; --reader-text: oklch(0.79 0.006 90); }

  @media (min-width: 1200px) {
    .weeklyReader main {
      margin-left: 272px;
      padding-right: clamp(0px, calc((100vw - 1200px) * 0.4), 160px);
    }
  }

  .weeklyArticle {
    max-width: 800px;
    margin: calc(clamp(28px, 5vh, 56px) + 36px) auto 0;
    padding: 36px 0 10vh;
  }
  .articleHeader { padding-bottom: 28px; }
  .homeLink {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: color 0.35s var(--ease-out), transform 0.35s var(--ease-out);
  }
  .homeLink:hover { color: var(--ink); transform: translateX(-3px); }
  .homeLink:focus-visible { outline-offset: 5px; }
  .homeLinkIcon { width: 17px; height: 17px; }
  .articleHeader h1 {
    max-width: 100%;
    margin: 22px 0 0;
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.065em;
    overflow-wrap: anywhere;
  }
  .articleSummary {
    max-width: 75ch;
    margin: 0 0 32px;
    color: var(--reader-text);
    font-size: 16px;
    line-height: 1.85;
  }

  .articleCover {
    margin: 0 0 20px;
  }
  .articleCover img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--hairline);
    border-radius: 14px;
  }

  .markdownContent {
    max-width: min(100%, 75ch);
    color: var(--reader-text);
    font-size: 17px;
    line-height: 1.95;
  }
  .markdownContent :global(p) { margin: 0 0 1.35em; }
  .markdownContent :global(h2) {
    margin: 2em 0 0.8em;
    padding-top: 1em;
    border-top: 1px solid color-mix(in oklch, var(--hairline) 70%, transparent);
    color: var(--ink);
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.1;
    letter-spacing: -0.045em;
  }
  .markdownContent :global(h3) {
    margin: 1.5em 0 0.4em;
    color: var(--ink);
    font-size: 21px;
    line-height: 1.4;
  }
  .markdownContent :global(a) {
    color: var(--signal);
    text-decoration-color: var(--highlight);
    text-underline-offset: 0.18em;
  }
  .markdownContent :global(img),
  .markdownContent :global(video) {
    display: block;
    width: 100%;
    height: auto;
    margin: 2em 0;
    border: 1px solid var(--hairline);
    border-radius: 3px;
  }
  .markdownContent :global(blockquote) {
    margin: 2em 0;
    padding: 2px 0 2px 20px;
    border-left: 1px solid var(--highlight);
    color: var(--text-secondary);
  }
  .markdownContent :global(ul),
  .markdownContent :global(ol) { margin: 0 0 1.35em; padding-left: 1.4em; }
  .markdownContent :global(li) { margin: 0.4em 0; }
  .markdownContent :global(li)::marker { color: var(--highlight); }
  .markdownContent :global(hr) { margin: 2.8em 0; border: 0; border-top: 1px solid var(--hairline); }
  .markdownContent :global(code) {
    padding: 2px 5px;
    background: var(--surface);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.88em;
  }
  .markdownContent :global(pre) {
    margin: 2em 0;
    padding: 18px;
    overflow-x: auto;
    border: 1px solid var(--hairline);
    background: var(--surface);
    font-size: 13px;
    line-height: 1.65;
  }
  .markdownContent :global(pre code) { padding: 0; background: transparent; }

  @media (max-width: 700px) {
    .weeklyArticle {
      margin-top: 68px;
      padding-top: 32px;
    }
    .articleHeader { padding-bottom: 24px; }
    .articleCover { margin-bottom: 24px; }
    .articleSummary { margin-bottom: 48px; }
    .markdownContent { font-size: 16px; }
  }
</style>
