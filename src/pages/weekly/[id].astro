---
import { getCollection, render } from 'astro:content';
import SiteBackdrop from '../../components/home/SiteBackdrop.astro';
import SubHeader from '../../components/SubHeader.astro';
import CoverLightbox from '../../components/CoverLightbox.astro';
import { issueDate, issueLabel, issueNeighbors, sortWeekly, weeklyPath } from '../../lib/weekly';
import '../../styles/global.css';

export async function getStaticPaths() {
  const issues = sortWeekly(await getCollection('weekly', ({ data }) => data.published));
  return issues.map((issue) => ({ params: { id: issue.id }, props: { issue, issues } }));
}

const { issue, issues } = Astro.props;
const { Content } = await render(issue);
const { newer, older } = issueNeighbors(issues, issue);
const title = `${issueLabel(issue.data.vol)} ${issue.data.title} — 周刊 — Oppenheimor`;
const description = issue.data.summary;
const year = new Date().getFullYear();
const isoDate = issue.data.date.toISOString().slice(0, 10);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c1426" />
    <title>{title}</title>
  </head>
  <body>
    <SiteBackdrop />
    <div class="site-column issueColumn">
      <SubHeader section="weekly" />
      <main>
        <a class="backLink" href="/weekly"><span aria-hidden="true">←</span> 返回周刊</a>

        <header class="issueHeading">
          <div class="headingMeta">
            <span>{issueLabel(issue.data.vol)} / Weekly</span>
            <time datetime={isoDate}>{issueDate(issue.data.date)}</time>
            <span>每周一发布</span>
          </div>
          <h1>{issue.data.title}</h1>
          <p class="dek">{issue.data.summary}</p>
          {issue.data.tags.length > 0 && (
            <ul class="headingTags" aria-label="标签">
              {issue.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}
        </header>

        <div class="issueBody">
          <aside class="issueAside" aria-label="本期导航">
            <div class="asideSticky">
              <button
                class="asideCover"
                type="button"
                data-cover-preview={issue.data.coverFull ?? issue.data.cover}
                data-cover-name={`${issueLabel(issue.data.vol)} ${issue.data.title}`}
                aria-label={`放大 ${issueLabel(issue.data.vol)} 封面`}
              >
                <img src={issue.data.cover} alt={`${issueLabel(issue.data.vol)} 封面`} />
              </button>

              <button class="switchButton" type="button" data-open-issue-nav aria-haspopup="dialog">
                <span>切换期数</span>
                <b>{String(issues.length).padStart(2, '0')}</b>
              </button>

              <nav class="asidePager" aria-label="相邻期数">
                {older ? (
                  <a href={weeklyPath(older)} rel="prev">
                    <span>上一期</span>
                    <strong>{issueLabel(older.data.vol)} {older.data.title}</strong>
                  </a>
                ) : (
                  <span class="asideEmpty">已经是最早的一期</span>
                )}
                {newer ? (
                  <a href={weeklyPath(newer)} rel="next">
                    <span>下一期</span>
                    <strong>{issueLabel(newer.data.vol)} {newer.data.title}</strong>
                  </a>
                ) : (
                  <span class="asideEmpty">这已经是最新一期</span>
                )}
              </nav>
            </div>
          </aside>

          <article class="issueContent">
            <Content />
          </article>
        </div>

        <nav class="issuePager" aria-label="相邻期数">
          {older ? (
            <a class="pagerBlock" href={weeklyPath(older)} rel="prev">
              <span>{issueLabel(older.data.vol)} · 上一期</span>
              <strong>{older.data.title}</strong>
              <b aria-hidden="true">←</b>
            </a>
          ) : (
            <span class="pagerBlock isDisabled">
              <span>上一期</span>
              <strong>已经是最早的一期</strong>
            </span>
          )}
          {newer ? (
            <a class="pagerBlock pagerNext" href={weeklyPath(newer)} rel="next">
              <span>{issueLabel(newer.data.vol)} · 下一期</span>
              <strong>{newer.data.title}</strong>
              <b aria-hidden="true">→</b>
            </a>
          ) : (
            <span class="pagerBlock isDisabled pagerNext">
              <span>下一期</span>
              <strong>这一期还没写完</strong>
            </span>
          )}
        </nav>
      </main>
      <footer><span>© {year} OPPENHEIMOR®</span><a href="/weekly">周刊归档</a></footer>
    </div>

    <button class="issueFab" type="button" data-open-issue-nav aria-haspopup="dialog">
      <span aria-hidden="true">☰</span> 期数
    </button>

    <dialog class="issueDialog" data-issue-dialog aria-labelledby="issueDialogTitle">
      <div class="dialogInner">
        <header class="dialogHead">
          <div>
            <p class="dialogKicker">ARCHIVE / 周刊归档</p>
            <h2 id="issueDialogTitle">全部期数</h2>
          </div>
          <button class="dialogClose" type="button" data-issue-dialog-close aria-label="关闭期数导航">×</button>
        </header>
        <ol class="dialogList">
          {issues.map((item) => (
            <li>
              <a class="dialogItem" href={weeklyPath(item)} aria-current={item.id === issue.id ? 'page' : undefined}>
                <span class="dialogCover"><img src={item.data.cover} alt="" loading="lazy" /></span>
                <span class="dialogText">
                  <span class="dialogMeta">
                    <b>{issueLabel(item.data.vol)}</b>
                    <time datetime={item.data.date.toISOString().slice(0, 10)}>{issueDate(item.data.date)}</time>
                  </span>
                  <strong>{item.data.title}</strong>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </dialog>

    <CoverLightbox />

    <script>
      const dialog = document.querySelector<HTMLDialogElement>('[data-issue-dialog]');
      const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-issue-dialog-close]');
      const currentItem = dialog?.querySelector<HTMLElement>('[aria-current="page"]');
      let restoreOverflow = '';
      let closing = false;

      const closeDialog = () => {
        if (!dialog?.open || closing) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          dialog.close();
          return;
        }
        closing = true;
        const finish = () => {
          closing = false;
          if (dialog.open) dialog.close();
        };
        dialog.classList.add('isClosing');
        dialog.addEventListener('animationend', finish, { once: true });
        window.setTimeout(finish, 420);
      };

      document.querySelectorAll<HTMLButtonElement>('[data-open-issue-nav]').forEach((trigger) => {
        trigger.addEventListener('click', () => {
          if (!dialog || dialog.open) return;
          restoreOverflow = document.documentElement.style.overflow;
          dialog.showModal();
          document.documentElement.style.overflow = 'hidden';
          currentItem?.scrollIntoView({ block: 'center' });
        });
      });

      closeButton?.addEventListener('click', closeDialog);
      dialog?.addEventListener('cancel', (event) => {
        event.preventDefault();
        closeDialog();
      });
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) closeDialog();
      });
      dialog?.addEventListener('close', () => {
        dialog.classList.remove('isClosing');
        document.documentElement.style.overflow = restoreOverflow;
      });
    </script>
  </body>
</html>

<style>
  .issueColumn { max-width: 1080px; }

  .backLink {
    display: inline-flex;
    gap: 10px;
    margin-top: clamp(70px, 11vh, 120px);
    color: var(--text-muted);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .backLink:hover { color: var(--ink); }

  .issueHeading { padding: 30px 0 clamp(48px, 8vh, 78px); }

  .headingMeta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    color: var(--text-muted);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
  }
  .headingMeta span:first-child { color: var(--ink); }
  .headingMeta span:last-child {
    padding-left: 24px;
    border-left: 1px solid var(--hairline);
    color: var(--signal);
  }

  h1 {
    max-width: 16ch;
    margin: 26px 0 0;
    font-size: clamp(56px, 8.6vw, 116px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.07em;
    overflow-wrap: anywhere;
  }

  .dek {
    max-width: 44ch;
    margin: 30px 0 0;
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 1.85;
  }

  .headingTags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .headingTags li {
    padding: 7px 12px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    color: var(--text-muted);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
  }

  .issueBody {
    display: grid;
    grid-template-columns: 336px minmax(0, 1fr);
    gap: clamp(44px, 6vw, 84px);
    align-items: stretch;
    padding-bottom: 8vh;
  }

  .asideSticky {
    position: sticky;
    top: clamp(28px, 7vh, 72px);
  }

  .asideCover {
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 6px;
    background: var(--surface);
    box-shadow: 0 34px 60px -46px var(--shadow);
    cursor: pointer;
    aspect-ratio: 3 / 2;
    transform: rotate(-1deg);
    transition: transform 0.7s var(--ease-out), border-color 0.6s var(--ease-out);
  }
  .asideCover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease-out);
  }

  .switchButton {
    display: flex;
    width: 100%;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-top: 20px;
    padding: 15px 18px;
    border: 1px solid var(--hairline);
    border-radius: 4px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font-size: 13px;
    letter-spacing: 0.08em;
    transition: background 0.45s var(--ease-out), border-color 0.45s var(--ease-out);
  }
  .switchButton b {
    color: var(--signal);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.12em;
  }

  .asidePager {
    display: grid;
    gap: 2px;
    margin-top: 34px;
    border-top: 1px solid var(--hairline);
  }
  .asidePager a {
    display: grid;
    gap: 6px;
    padding: 15px 2px;
    border-bottom: 1px solid var(--hairline);
    text-decoration: none;
  }
  .asidePager a span {
    color: var(--text-muted);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 9px;
    letter-spacing: 0.14em;
  }
  .asidePager a strong {
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.5;
    transition: color 0.4s var(--ease-out);
  }
  .asidePager a:hover strong { color: var(--ink); }
  .asideEmpty {
    padding: 15px 2px;
    border-bottom: 1px solid var(--hairline);
    color: var(--text-muted);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .issueContent {
    min-width: 0;
    max-width: 70ch;
    color: var(--text-secondary);
    font-size: 16.5px;
    line-height: 1.95;
  }
  .issueContent :global(p) { margin: 0 0 1.35em; }
  .issueContent :global(p:first-child) { color: var(--ink); font-size: 18px; line-height: 1.85; }
  .issueContent :global(h2) {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 2.6em 0 1.1em;
    padding-top: 1.4em;
    border-top: 1px solid var(--hairline);
    color: var(--ink);
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }
  .issueContent :global(h2)::before {
    flex: none;
    width: 26px;
    height: 1px;
    background: var(--highlight);
    content: '';
  }
  .issueContent :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: 0; }
  .issueContent :global(h3) {
    margin: 2.2em 0 0.5em;
    color: var(--ink);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.02em;
  }
  .issueContent :global(h3) + :global(p) { margin-bottom: 0.9em; }
  .issueContent :global(a) {
    text-decoration-color: var(--highlight);
    text-decoration-thickness: 0.2em;
    text-underline-offset: 0.14em;
  }
  .issueContent :global(h3) + :global(p) a {
    color: var(--signal);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 12px;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
  }
  .issueContent :global(h3) + :global(p) a:hover { text-decoration: underline; text-decoration-thickness: 0.1em; }
  .issueContent :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.8em 0;
    border: 1px solid var(--hairline);
    border-radius: 4px;
    background: var(--surface);
  }
  .issueContent :global(blockquote) {
    margin: 1.8em 0;
    padding: 2px 0 2px 22px;
    border-left: 2px solid var(--highlight);
    color: var(--text-secondary);
  }
  .issueContent :global(blockquote) :global(p):last-child { margin-bottom: 0; }
  .issueContent :global(hr) { margin: 2.6em 0; border: 0; border-top: 1px solid var(--hairline); }
  .issueContent :global(ul),
  .issueContent :global(ol) { margin: 0 0 1.35em; padding-left: 1.3em; }
  .issueContent :global(li) { margin: 0.4em 0; }
  .issueContent :global(li)::marker { color: var(--text-muted); }
  .issueContent :global(code) {
    padding: 2px 6px;
    background: var(--surface);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.88em;
  }
  .issueContent :global(pre) {
    margin: 1.8em 0;
    padding: 20px;
    overflow-x: auto;
    border: 1px solid var(--hairline);
    background: oklch(0.13 0.025 255);
    font-size: 13px;
    line-height: 1.65;
  }
  .issueContent :global(pre) :global(code) { padding: 0; background: transparent; }
  .issueContent :global(em) { color: var(--text-muted); font-size: 0.92em; }
  .issueContent :global(table) { width: 100%; margin: 1.8em 0; border-collapse: collapse; font-size: 14px; }
  .issueContent :global(th),
  .issueContent :global(td) { padding: 10px 12px; border-bottom: 1px solid var(--hairline); text-align: left; }

  .issuePager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-bottom: 6vh;
    background: var(--hairline);
  }
  .pagerBlock {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 34px 30px 38px;
    background: var(--canvas);
    text-decoration: none;
    transition: background 0.5s var(--ease-out);
  }
  .pagerBlock > span {
    color: var(--text-muted);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
  }
  .pagerBlock strong {
    color: var(--ink);
    font-size: clamp(21px, 2.6vw, 28px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }
  .pagerBlock b { color: var(--highlight); font-size: 20px; font-weight: 400; }
  .pagerNext { justify-items: end; text-align: right; }
  .pagerBlock.isDisabled strong { color: var(--text-muted); font-weight: 400; }
  .pagerBlock.isDisabled { cursor: default; }

  .issueFab {
    position: fixed;
    right: 18px;
    bottom: calc(18px + env(safe-area-inset-bottom, 0px));
    z-index: 12;
    display: none;
    align-items: center;
    gap: 8px;
    padding: 13px 18px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--surface-raised);
    color: var(--ink);
    box-shadow: 0 20px 40px -22px var(--shadow);
    cursor: pointer;
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  .issueFab span { color: var(--signal); font-size: 13px; }

  .issueDialog {
    width: min(880px, calc(100vw - 48px));
    max-width: none;
    max-height: min(84vh, 780px);
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    background: var(--surface-raised);
    color: var(--ink);
    box-shadow: 0 60px 120px -60px oklch(0.05 0.02 265 / 0.9);
  }
  .issueDialog[open] { display: block; animation: dialogIn 0.5s var(--ease-out) both; }
  .issueDialog.isClosing { animation: dialogOut 0.28s ease-in both; }
  .issueDialog::backdrop { background: oklch(0.1 0.02 255 / 0.82); animation: backdropIn 0.4s var(--ease-out) both; }
  .issueDialog.isClosing::backdrop { animation: backdropOut 0.28s ease-in both; }

  @keyframes sheetIn { from { opacity: 0; transform: translateY(100%); } to { opacity: 1; transform: none; } }
  @keyframes sheetOut { from { opacity: 1; transform: none; } to { opacity: 0; transform: translateY(100%); } }
  @keyframes dialogIn { from { opacity: 0; transform: translateY(20px) scale(0.985); } to { opacity: 1; transform: none; } }
  @keyframes dialogOut { from { opacity: 1; transform: none; } to { opacity: 0; transform: translateY(14px) scale(0.99); } }
  @keyframes backdropIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes backdropOut { from { opacity: 1; } to { opacity: 0; } }

  .dialogInner { display: flex; max-height: inherit; flex-direction: column; }

  .dialogHead {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 32px 22px;
    border-bottom: 1px solid var(--hairline);
  }
  .dialogKicker {
    margin: 0 0 10px;
    color: var(--text-muted);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
  }
  .dialogHead h2 {
    margin: 0;
    font-size: clamp(28px, 3.4vw, 38px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .dialogClose {
    width: 40px;
    height: 40px;
    flex: none;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font-size: 22px;
    line-height: 1;
    transition: background 0.4s var(--ease-out), transform 0.5s var(--ease-out);
  }

  .dialogList {
    display: grid;
    min-height: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    overflow-y: auto;
    list-style: none;
    overscroll-behavior: contain;
  }
  .dialogList li { border-bottom: 1px solid var(--hairline); }
  .dialogList li:nth-child(odd) { border-right: 1px solid var(--hairline); }
  .dialogItem {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    align-items: center;
    gap: 18px;
    height: 100%;
    padding: 18px 22px;
    background: var(--surface-raised);
    color: inherit;
    text-decoration: none;
    transition: background 0.4s var(--ease-out);
  }
  .dialogCover {
    display: block;
    overflow: hidden;
    border: 1px solid var(--hairline);
    background: var(--surface);
    aspect-ratio: 3 / 2;
  }
  .dialogCover img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .dialogText { display: grid; min-width: 0; gap: 8px; }
  .dialogMeta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    color: var(--text-muted);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
  }
  .dialogMeta b { color: var(--signal); font-weight: 400; }
  .dialogText strong {
    color: var(--text-secondary);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.025em;
    transition: color 0.4s var(--ease-out);
  }
  .dialogItem[aria-current='page'] { background: var(--highlight-soft); }
  .dialogItem[aria-current='page'] strong { color: var(--ink); }
  .dialogItem[aria-current='page'] .dialogCover { border-color: var(--highlight); }

  @media (hover: hover) and (pointer: fine) {
    .asideCover:hover { border-color: oklch(0.48 0.11 250); transform: rotate(0deg) scale(1.015); }
    .switchButton:hover { border-color: var(--highlight); background: var(--highlight-soft); }
    .pagerBlock:not(.isDisabled):hover { background: oklch(0.17 0.038 267 / 0.7); }
    .dialogClose:hover { background: var(--highlight-soft); transform: rotate(90deg); }
    .dialogItem:hover { background: oklch(0.2 0.042 266); }
    .dialogItem:hover strong { color: var(--ink); }
  }

  @media (max-width: 1000px) {
    .issueBody { grid-template-columns: 264px minmax(0, 1fr); gap: 44px; }
  }

  @media (max-width: 820px) {
    .issueBody { grid-template-columns: 1fr; gap: 44px; }
    .asideSticky { position: static; display: grid; gap: 22px; }
    .asidePager { display: none; }
    .issueFab { display: inline-flex; }
  }

  @media (max-width: 700px) {
    .backLink { margin-top: 58px; }
    h1 { max-width: none; margin-top: 22px; font-size: clamp(44px, 14vw, 74px); }
    .dek { margin-top: 24px; font-size: 15px; }
    .issueHeading { padding-bottom: 40px; }
    .issueContent { font-size: 16px; line-height: 1.9; }
    .issueContent :global(p:first-child) { font-size: 17px; }
    .issueContent :global(h2) { margin-top: 2.2em; font-size: 28px; }

    .issuePager { grid-template-columns: 1fr; }
    .pagerBlock { padding: 26px 20px 30px; }
    .pagerNext { justify-items: start; text-align: left; }

    .issueDialog {
      width: 100%;
      max-width: none;
      max-height: 84vh;
      margin: auto 0 0;
      border-radius: 14px 14px 0 0;
    }
